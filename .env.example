# ─── Core (required) ───────────────────────────────────────────────
SEC_USER_AGENT="Your Name your@email.com"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/moat"

# Supabase Auth API base (JWKS). Not the Postgres host.
SUPABASE_URL="https://your-project-ref.supabase.co"
AUTH_REQUIRED=true
FRONTEND_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# ─── LLM providers (at least one for Ask/Agent/embeddings) ──────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MODEL_FLAGSHIP=openai/gpt-4o
MODEL_CHEAP=groq/llama-3.1-8b-instant
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# ─── Rerank: local | cohere | none ──────────────────────────────────
# Docker/Render image defaults to cohere (no local model download).
# local needs: pip install -e "backend[local-rerank]" (heavy RAM).
RERANK_PROVIDER=cohere
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0

# ─── Observability (optional) ───────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Quotas / ops ───────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
REDIS_URL=
METRICS_TOKEN=
ANSWER_CACHE_ENABLED=false
MOAT_DEFAULT_UNIVERSE=
ADMIN_USER_IDS=
# Persist LangGraph agent state in Postgres (same DATABASE_URL).
AGENT_CHECKPOINT=true

# Cost / abuse (DB-backed; Redis not required)
LLM_ENABLED=true
AGENT_ENABLED=true
# Free plan: Agent on (shares monthly ask quota). Set false for Pro-only Agent.
FREE_AGENT_ENABLED=true
# USD from usage_log.cost_usd; 0 disables a cap.
DAILY_COST_USD_PER_USER=1.0
DAILY_COST_USD_GLOBAL=25.0
AGENT_MAX_TOOL_ROUNDS=6
AGENT_MAX_COST_USD_PER_RUN=0.5
BLOCK_DISPOSABLE_EMAIL=true
# Comma-separated extra blocked email domains
BLOCKED_EMAIL_DOMAINS=
# New users / rolling hour; 0 disables
MAX_SIGNUPS_PER_HOUR=30

# ─── Stripe (optional until you enable checkout) ────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID is a legacy alias for STRIPE_PRICE_ID_PRO
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=
